# ─────────────────────────────────────────────────────────────
# Environment template for the social-listening api-server.
# Copy to `.env` at the repo root and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# The server reads process.env directly (no dotenv). Run it with
# Node's native env loader, e.g.:
#   pnpm --filter @workspace/api-server exec tsx --env-file=../../.env watch src/index.ts
# (or pass --env-file=.env to your run command).
# ─────────────────────────────────────────────────────────────

# --- Secrets (provided by the Company) ---

# Neon PostgreSQL connection string (Drizzle / node-postgres pool)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Apify API token — used to launch/read actor runs
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key — entity / attribute extraction
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Local config (set as you like) ---

# development | production
NODE_ENV=development

# pino log level: debug | info | warn | error
LOG_LEVEL=debug

# Port the api-server listens on (defaults to 8080 if unset)
PORT=8080

# Vite dev server port the app runs on (defaults to 5173)
VITE_PORT=5173

# Base URL the server uses to build webhook callbacks for Apify.
# Locally this needs to be a publicly reachable tunnel (e.g. ngrok)
# if you want Apify webhooks to reach you; otherwise leave for dev.
SERVER_URL=http://localhost:8080

# --- Replit-only (ignore for local dev) ---
# REPLIT_DOMAINS=
